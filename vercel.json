{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/opensky.js": {
      "maxDuration": 15
    },
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "config/**"
    },
    "api/gbfs/[...target].js": {
      "maxDuration": 15
    },
    "api/cctv/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "config/**"
    },
    "api/cctv/frame/[id].js": {
      "maxDuration": 30,
      "includeFiles": "config/**"
    },
    "api/cctv/stream/[id].js": {
      "maxDuration": 30,
      "includeFiles": "config/**"
    },
    "api/cctv/media/[id].js": {
      "maxDuration": 30,
      "includeFiles": "config/**"
    },
    "api/celestrak/[...group].js": {
      "maxDuration": 20
    },
    "api/billing/[...path].js": {
      "maxDuration": 15
    },
    "api/stripe/webhook.js": {
      "maxDuration": 15
    },
    "api/tomtom/[...path].js": {
      "maxDuration": 15
    },
    "api/adsbdb/[...path].js": {
      "maxDuration": 15
    },
    "api/launches.js": {
      "maxDuration": 30
    },
    "api/firms/index.js": {
      "maxDuration": 60
    },
    "api/firms/status.js": {
      "maxDuration": 15
    },
    "api/adsblol/trace.js": {
      "maxDuration": 15
    },
    "api/opensky-track.js": {
      "maxDuration": 10
    },
    "api/adsblol/mil.js": {
      "maxDuration": 15
    },
    "api/route.js": {
      "maxDuration": 20
    },
    "api/weather-effects.js": {
      "maxDuration": 15
    },
    "api/regional-brief.js": {
      "maxDuration": 15
    },
    "api/google/nearby-places.js": {
      "maxDuration": 15
    },
    "api/radio/[...path].js": {
      "maxDuration": 30
    },
    "api/terrain/heights.js": {
      "maxDuration": 30
    },
    "api/realtime/token.js": {
      "maxDuration": 15
    },
    "api/openai/hud-summary.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/tomtom/flow/:z/:x/:y.pbf",
      "destination": "/api/tomtom/flow/:z/:x/:y"
    }
  ]
}
