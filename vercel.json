{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/opensky.js": {
      "maxDuration": 15
    },
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "config/**"
    },
    "api/cctv/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "config/cctv_sources*.json"
    },
    "api/gbfs/[...target].js": {
      "maxDuration": 15
    },
    "api/billing/[...path].js": {
      "maxDuration": 15
    },
    "api/stripe/webhook.js": {
      "maxDuration": 15
    },
    "api/firms/index.js": {
      "maxDuration": 60
    },
    "api/firms/status.js": {
      "maxDuration": 15
    }
  }
}
