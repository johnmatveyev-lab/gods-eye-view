{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "config/**"
    },
    "api/billing/[...path].js": {
      "maxDuration": 15
    },
    "api/gbfs/[...target].js": {
      "maxDuration": 15
    },
    "api/stripe/webhook.js": {
      "maxDuration": 15
    }
  }
}
